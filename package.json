{
  "name": "freepay",
  "version": "0.1.0",
  "private": true,
  "description": "Free Pay - offline-first digital payments for large pilgrimage events (mobile app package; see /server and /admin)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:build": "expo export --platform web",
    "web:serve": "node scripts/serve-web.mjs",
    "demo:web": "npm run web:build && npm run web:serve",
    "setup": "npm install && npm --prefix server install && npm --prefix admin install",
    "dev:mobile": "expo start",
    "dev:server": "npm --prefix server run dev",
    "dev:admin": "npm --prefix admin run dev",
    "dev": "concurrently -n server,admin -c yellow,magenta \"npm run dev:server\" \"npm run dev:admin\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm --prefix server run migrate",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "npm run typecheck && npm --prefix server run typecheck && npm --prefix admin run typecheck",
    "test": "jest",
    "test:all": "jest && npm --prefix server test && npm --prefix admin test",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.103.1",
    "expo": "~57.0.24",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.3"
  }
}

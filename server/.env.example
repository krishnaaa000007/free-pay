# ---- Free Pay API ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (admin dashboard, Expo web).
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# JWT (7 day expiry). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Platform Ed25519 signing seed (base64, 32 bytes). Generate with: npm run keys
# The matching PUBLIC key goes into the mobile app as EXPO_PUBLIC_PLATFORM_PUBKEY.
PLATFORM_SIGNING_SEED=
PLATFORM_KEY_ID=freepay-platform-2026

# ---- Database ----
# The API connects as a NON-SUPERUSER role (freepay_app) so PostgreSQL row-level security
# cannot be bypassed. Migrations run as the owner/admin user and create that role.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=freepay
DB_USER=freepay_app
DB_PASSWORD=freepay_app_dev_password
DB_SSL=false
# Admin / owner credentials, used ONLY by the migration runner.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=postgres
# Optional: full connection strings override the fields above.
# DATABASE_URL=postgres://freepay_app:freepay_app_dev_password@localhost:5432/freepay
# DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/freepay

# ---- Optional SSH tunnel to a remote Postgres ----
SSH_TUNNEL_ENABLED=false
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=
SSH_REMOTE_DB_HOST=127.0.0.1
SSH_REMOTE_DB_PORT=5432
SSH_LOCAL_PORT=15432

# ---- Fraud / offline limits (INR) ----
FRAUD_MAX_SINGLE_OFFLINE_INR=2000
FRAUD_MAX_DAILY_OFFLINE_INR=5000
FRAUD_REVIEW_THRESHOLD_INR=1500
FRAUD_MAX_OFFLINE_AGE_DAYS=10
FRAUD_VELOCITY_WINDOW_MIN=10
FRAUD_VELOCITY_MAX_TXNS=12
ONLINE_RECEIPT_TTL_MIN=15

# ---- Emergency ----
EMERGENCY_SHARE_TTL_MIN=60
EMERGENCY_CONTACTS=Mela Control Room:1077,Police:112,Ambulance:108,Lost and Found:1098

# Single-device pitch demo endpoint (/api/demo). Ignored in production.
DEMO_MODE=true

# ---- AI assistant proxy (OpenAI). Leave empty to disable (route returns 503). ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

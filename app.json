{
  "expo": {
    "name": "Free Pay",
    "slug": "freepay",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "freepay",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.freepay.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Free Pay scans payment and merchant QR codes.",
        "NSLocationWhenInUseUsageDescription": "Free Pay shares your location with responders during an SOS and shows crowd density near you."
      }
    },
    "android": {
      "package": "org.freepay.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E8891D"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Free Pay scans payment and merchant QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Free Pay shares your location with responders during an SOS."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7EFE3",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

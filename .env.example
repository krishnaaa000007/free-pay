# ---- Free Pay mobile app (Expo) ----
# Only EXPO_PUBLIC_* variables are bundled into the app.

# API base URL. For a real device on the same Wi-Fi, use your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Platform Ed25519 public key (base64). Must match PLATFORM_SIGNING_SEED on the server.
# Printed by `npm --prefix server run keys` - copy the PUBLIC key here.
EXPO_PUBLIC_PLATFORM_PUBKEY=

# Offline limits (INR). Enforced on-device; the server enforces the same limits again.
EXPO_PUBLIC_MAX_OFFLINE_TXN_INR=2000
EXPO_PUBLIC_MAX_OFFLINE_DAILY_INR=5000
# Max age of an offline authorisation / wallet credential in days (hard cap 10).
EXPO_PUBLIC_MAX_OFFLINE_AGE_DAYS=10
# Online (merchant-verification) receipt TTL in minutes.
EXPO_PUBLIC_ONLINE_RECEIPT_TTL_MIN=15

# Emergency contacts shown when the server is unreachable (label:number, comma separated).
EXPO_PUBLIC_EMERGENCY_CONTACTS=Mela Control Room:1077,Police:112,Ambulance:108,Lost and Found:1098

# Presentation aid: hand the QR string between two browser windows on one desktop, in place
# of a camera that cannot see the other monitor. Every signature, expiry, limit and fraud
# check still runs. Needs DEMO_MODE=true on the server. Leave blank for phones/production.
EXPO_PUBLIC_DEMO_RELAY=

# Default UI language: en | hi | mr | gu | ta
EXPO_PUBLIC_DEFAULT_LANGUAGE=en
